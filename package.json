{
  "name": "md-viewer",
  "version": "2.8.0",
  "description": "A simple and powerful Markdown preview tool with Mermaid diagrams and file watching",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run chart-examples:generate",
    "dev": "electron-vite dev",
    "prebuild": "npm run chart-examples:generate",
    "build": "electron-vite build",
    "chart-examples:generate": "node scripts/generate-chart-examples.mjs",
    "chart-examples:check": "node scripts/generate-chart-examples.mjs --check",
    "generate:katex-css": "node scripts/generate-katex-woff2-css.mjs",
    "verify:katex-css": "node scripts/generate-katex-woff2-css.mjs --check",
    "verify:runtime": "node scripts/verify-runtime-dependencies.mjs",
    "prepare:package-app": "npm run verify:runtime && node scripts/prepare-package-app.mjs",
    "inspect:package-app": "node scripts/inspect-package-app.mjs",
    "package:staged:dir": "npm run build && npm run prepare:package-app && electron-builder --config electron-builder.staged.cjs --dir",
    "build:staged:mac": "npm run build && npm run prepare:package-app && electron-builder --config electron-builder.staged.cjs --mac",
    "build:staged:win": "npm run build && npm run prepare:package-app && electron-builder --config electron-builder.staged.cjs --win",
    "build:staged:linux": "npm run build && npm run prepare:package-app && electron-builder --config electron-builder.staged.cjs --linux",
    "verify:package": "npm run inspect:package-app && node scripts/inspect-packaged-app.mjs && node scripts/smoke-packaged-app.mjs && node scripts/check-artifact-sizes.mjs && npm run test:e2e:packaged",
    "test:e2e:packaged": "node scripts/run-packaged-e2e.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:renderer": "vitest --run src/renderer src/shared",
    "test:main": "vitest --config vitest.main.config.ts --run",
    "test:unit": "npm run test:renderer && npm run test:main",
    "test:e2e:release": "playwright test",
    "test:e2e:interactive": "node scripts/run-interactive-e2e.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chart-benchmark": "node scripts/run-chart-gallery-benchmark.mjs",
    "test:e2e:ui": "playwright test --ui",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "release:check": "./scripts/release-check.sh",
    "baseline": "node scripts/export-baseline.mjs"
  },
  "build": {
    "appId": "com.mdviewer.app",
    "productName": "MD Viewer",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": false
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": false
      },
      {
        "ext": "mdown",
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": false
      },
      {
        "ext": "mkd",
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": false
      },
      {
        "ext": "mdx",
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": false
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/reference.docx",
        "to": "reference.docx"
      },
      {
        "from": "resources/reference-gongwen.docx",
        "to": "reference-gongwen.docx"
      },
      {
        "from": "resources/lua",
        "to": "lua"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/examples/md-viewer-chart-examples.zip",
        "to": "examples/md-viewer-chart-examples.zip"
      },
      {
        "from": "resources/examples/md-viewer-chart-examples.manifest.json",
        "to": "examples/md-viewer-chart-examples.manifest.json"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 180,
          "y": 190,
          "type": "file"
        },
        {
          "x": 380,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 280,
          "y": 320,
          "type": "file",
          "path": "resources/mac-first-open-note.txt",
          "name": "首次打开说明.txt"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "perMachine": true,
      "allowElevation": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "mimeTypes": [
        "text/markdown"
      ]
    }
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron",
    "react"
  ],
  "author": {
    "name": "wj2929",
    "email": "wj2929@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/dompurify": "^3.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mark.js": "^8.11.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "dompurify": "^3.3.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "lodash.debounce": "^4.0.8",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.13",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hpcc-js/wasm-graphviz": "^1.21.0",
    "@terrastruct/d2": "^0.1.33",
    "@types/markdown-it": "^14.1.2",
    "@types/prismjs": "^1.26.5",
    "adm-zip": "^0.5.16",
    "bpmn-js": "^18.16.1",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "docx": "^9.5.1",
    "echarts": "^6.0.0",
    "electron-store": "^8.2.0",
    "fs-extra": "^11.3.3",
    "fuse.js": "^7.1.0",
    "glob": "^13.0.0",
    "isomorphic-dompurify": "^2.35.0",
    "json5": "^2.2.3",
    "katex": "^0.16.27",
    "mark.js": "^8.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.12.2",
    "msedge-tts": "2.0.7",
    "plantuml-encoder": "^1.4.0",
    "prismjs": "^1.30.0",
    "react-hot-toast": "^2.6.0",
    "react-virtuoso": "^4.18.1",
    "swr": "^2.3.8",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "wavedrom": "^3.6.1",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  }
}
